// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UnitSystem {
  WEIGHT
  VOLUME
  ABSTRACT
}

enum DueDateType {
  BEST_BEFORE
  EXPIRY_DATE
  NO_EXPIRY
}

enum PurchasePriceType {
  UNSPECIFIED // 1 in Grocy
  UNIT_PRICE // 2 in Grocy
  TOTAL_PRICE // 3 in Grocy
}

// grocy: default_stock_label_type
enum StockLabelType {
  NO_LABEL // 0
  SINGLE_LABEL // 1
  LABEL_PER_UNIT // 2
}

model Product {
  id                            Int               @id @default(autoincrement())
  userId                        Int
  createdBy                     User              @relation(fields: [userId], references: [id])
  createdAt                     DateTime
  // Essential capture fields
  name                          String
  barcodes                      Barcode[]
  grocyProductId                Int?
  pending                       Boolean
  canBeFrozen                   Boolean
  unitSystem                    UnitSystem        @default(WEIGHT)
  unitAmount                    String
  unitChosen                    Int
  defaultLocation               Int
  dueDateType                   DueDateType       @default(BEST_BEFORE)
  expiresAt                     String?
  packagingDate                 String?
  dueDays                       Int?
  dueDaysAfterOpen              Int?
  dueDaysAfterFreezing          Int?
  dueDaysAfterThawing           Int?
  productPhoto                  ProductPhoto?
  quantity                      Int               @default(1)
  notes                         String?
  // Additional capture fields
  productGroup                  Int?
  parentProductId               Int?
  consumeLocationId             Int?
  defaultShop                   Int?
  moveOnOpen                    Boolean           @default(false)
  enableTareWeight              Boolean           @default(false)
  disableStockChecking          Boolean           @default(false)
  openedAsOutOfStock            Boolean           @default(true)
  accumulateSubProductsMinStock Boolean           @default(false)
  tareWeight                    String?
  energy                        String?
  quickConsumeAmount            String?
  quickOpenAmount               String?
  purchasePriceType             PurchasePriceType @default(UNSPECIFIED)
  cantOpen                      Boolean           @default(false)
  dontShowOnStock               Boolean           @default(false)
  defaultQuantityUnitPurchase   Int?
  defaultQuantityUnitConsume    Int?
  quantityUnitPrices            Int?
  purchaseConversionFactor      String?
  consumeConversionFactor       String?
  priceConversionFactor         String?
  autoReprintStockLabel         Boolean           @default(false)
  defaultStockLabelType         StockLabelType    @default(NO_LABEL)
  purchasePrice                 String?
}

model Barcode {
  id        Int      @id @default(autoincrement())
  barcode   String   @unique
  productId Int?
  product   Product? @relation(fields: [productId], references: [id])
  scannedAt DateTime
  // "queued" flag means the scanner app actually accepted the barcode and it
  // was not simply received by the API. The API is indiscriminate, but the app
  // may filter requests based on state. Thus selecting for queued status one
  // does not end up with a lot of random queued codes to process without an
  // app open to see something about them.
  queued    Boolean  @default(false)
}

enum GrocyFileGroup {
  recipepictures
  productpictures
  userfiles
  userpictures
}

model ProductPhoto {
  id             Int             @id @default(autoincrement())
  userId         Int
  createdBy      User            @relation(fields: [userId], references: [id])
  productId      Int             @unique
  product        Product         @relation(fields: [productId], references: [id])
  filename       String
  filetype       String          @default("image/png")
  grocyFileGroup GrocyFileGroup? @default(productpictures)
  grocyFileName  String?
  data           Bytes
  lastChanged    Int?
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  name          String
  email         String
  created       DateTime
  settings      Settings?
  userApiKeys   UserApiKey[]
  products      Product[]
  productPhotos ProductPhoto[]
}

model Settings {
  userId              Int     @id
  user                User    @relation(fields: [userId], references: [id])
  openCameraByDefault Boolean @default(false)
  playSoundOnScan     Boolean @default(false)
}

model UserApiKey {
  id      Int      @id @default(autoincrement())
  userId  Int
  user    User     @relation(fields: [userId], references: [id])
  apiKey  String   @unique
  created DateTime
}
